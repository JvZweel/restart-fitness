{
  "name": "restart-fitness",
  "version": "1.0.0",
  "description": "Restart Fitness – offline PWA training companion",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p . && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "build:pages": "BASE_PATH=/restart-fitness/ npm run build",
    "e2e": "node e2e/run.mjs",
    "icons": "node scripts/icons.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "idb": "^8.0.4",
    "lucide-preact": "^1.70.0",
    "preact": "^10.29.8",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "playwright-core": "^1.65.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "private": true
}
